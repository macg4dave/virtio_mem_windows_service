# Copy to /etc/virtio-mem-host/<instance>.conf and replace every REQUIRED_*
# marker from reviewed deployment evidence. This file contains no secrets.
VIRTIO_MEM_VM_NAME=REQUIRED_VM_NAME
VIRTIO_MEM_ALIAS=REQUIRED_DEVICE_ALIAS

# These byte counts are deployment inputs. Derive device geometry and current
# allocation from live XML; calibrate policy bounds and reserves for this VM.
VIRTIO_MEM_MIN_MEMORY_BYTES=REQUIRED_MINIMUM_BYTES
VIRTIO_MEM_MAX_MEMORY_BYTES=REQUIRED_MAXIMUM_BYTES
VIRTIO_MEM_LOWER_THRESHOLD_BYTES=REQUIRED_LOWER_THRESHOLD_BYTES
VIRTIO_MEM_UPPER_THRESHOLD_BYTES=REQUIRED_UPPER_THRESHOLD_BYTES
VIRTIO_MEM_FIXED_VISIBLE_BASE_BYTES=REQUIRED_CALIBRATED_BASE_BYTES
VIRTIO_MEM_HOST_MIN_HEADROOM_BYTES=REQUIRED_HOST_HEADROOM_BYTES

# Persistent and transported state paths must be absolute, instance-scoped,
# and provisioned with the documented least-privilege ownership and ACLs.
VIRTIO_MEM_POLICY_STATE_PATH=REQUIRED_ABSOLUTE_POLICY_STATE_PATH
VIRTIO_MEM_RAW_TELEMETRY_PATH=REQUIRED_ABSOLUTE_RAW_TELEMETRY_PATH
VIRTIO_MEM_RAW_TELEMETRY_SERVICE_NAME=REQUIRED_WINDOWS_SERVICE_NAME
VIRTIO_MEM_COMPATIBILITY_ATTESTATION_PATH=REQUIRED_ABSOLUTE_ATTESTATION_PATH

# All operational timing is selected for this deployment. Record the rationale
# and ensure the service manager stop bound is compatible with these values.
VIRTIO_MEM_POLL_INTERVAL_SECONDS=REQUIRED_POLL_INTERVAL_SECONDS
VIRTIO_MEM_COMMAND_TIMEOUT_SECONDS=REQUIRED_COMMAND_TIMEOUT_SECONDS
VIRTIO_MEM_CONVERGENCE_TIMEOUT_SECONDS=REQUIRED_CONVERGENCE_TIMEOUT_SECONDS
VIRTIO_MEM_STATS_MAX_AGE_SECONDS=REQUIRED_STATS_MAX_AGE_SECONDS
VIRTIO_MEM_STATS_FUTURE_TOLERANCE_SECONDS=REQUIRED_STATS_FUTURE_TOLERANCE_SECONDS
VIRTIO_MEM_RAW_TELEMETRY_MAX_AGE_SECONDS=REQUIRED_TELEMETRY_MAX_AGE_SECONDS
VIRTIO_MEM_RAW_TELEMETRY_FUTURE_TOLERANCE_SECONDS=REQUIRED_TELEMETRY_FUTURE_TOLERANCE_SECONDS

# Current production modes. Automatic reclaim is default-on; set false only
# for a reviewed rollout pause or diagnosis. Re-notification is diagnostic.
VIRTIO_MEM_DEMAND_SOURCE=raw
VIRTIO_MEM_STATS_SOURCE=dommemstat
VIRTIO_MEM_AUTOMATIC_WINDOWS_SHRINK=true
VIRTIO_MEM_SHRINK_RENOTIFICATION=false
# Required only when re-notification is enabled. Supply a strictly increasing
# comma-separated schedule below the configured convergence timeout.
# VIRTIO_MEM_SHRINK_RETRY_DELAYS_SECONDS=REQUIRED_RETRY_SCHEDULE_SECONDS

# Optional policy inputs are deliberately omitted. When a deployment overrides
# growth/reclaim quanta, reserves, reclaim history/gap, hysteresis, or the
# virsh binary, record the reviewed values in its instance file. Otherwise the
# normative target-controller defaults apply.
