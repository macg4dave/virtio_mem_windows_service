# Install as /etc/virtio-mem-host/<instance>.conf. This file contains no secrets.
# The systemd instance name identifies this explicitly managed VM.
VIRTIO_MEM_VM_NAME=win11_gpu
VIRTIO_MEM_ALIAS=ua-virtiomem0

# All memory quantities are byte counts and must be compatible with the live
# virtio-mem block size. Choose limits only after inspecting the live device.
VIRTIO_MEM_MIN_MEMORY_BYTES=8589934592
VIRTIO_MEM_MAX_MEMORY_BYTES=17179869184
VIRTIO_MEM_LOWER_THRESHOLD_BYTES=1073741824
VIRTIO_MEM_UPPER_THRESHOLD_BYTES=4294967296

# Every external command is bounded. TimeoutStopSec must exceed this value.
VIRTIO_MEM_POLL_INTERVAL_SECONDS=30
VIRTIO_MEM_COMMAND_TIMEOUT_SECONDS=10
VIRTIO_MEM_CONVERGENCE_TIMEOUT_SECONDS=300
# VIRTIO_MEM_VIRSH_BINARY=/usr/bin/virsh

# dommemstat (virtio-balloon counters) is the default and does not require
# guest-get-memory-stats support. Set to "qga" only if the connected guest
# agent implements guest-get-memory-stats.
VIRTIO_MEM_STATS_SOURCE=dommemstat
# `last-update` must be no older than this bound and must advance between
# controller samples. Small positive future skew is tolerated explicitly.
VIRTIO_MEM_STATS_MAX_AGE_SECONDS=60
VIRTIO_MEM_STATS_FUTURE_TOLERANCE_SECONDS=5

# Required M10d raw Windows telemetry input. The deployment transport must
# present this VM/service-scoped path and provision its least-privilege ACL.
# The Windows publisher uses bounded atomic handoff/retention and the host
# persists replay acknowledgement beside this file. Provision the transport
# and parent-directory ACL for the selected deployment.
VIRTIO_MEM_RAW_TELEMETRY_PATH=/run/virtio-mem-host/win11_gpu.telemetry.jsonl
VIRTIO_MEM_RAW_TELEMETRY_SERVICE_NAME=VirtioMemService
VIRTIO_MEM_RAW_TELEMETRY_MAX_AGE_SECONDS=60
VIRTIO_MEM_RAW_TELEMETRY_FUTURE_TOLERANCE_SECONDS=5
# M10b safety controls are independent and default off when omitted.
VIRTIO_MEM_AUTOMATIC_WINDOWS_SHRINK=false
VIRTIO_MEM_SHRINK_RENOTIFICATION=false

# Required: a grow request is blocked unless the RHEL host's /proc/meminfo
# MemAvailable covers the requested delta plus this reserve.
VIRTIO_MEM_HOST_MIN_HEADROOM_BYTES=4294967296

# Required reviewed M9d attestation. Generate a candidate with the Rust
# `attest` command after completing the documented review, install it read-only
# for the service account, and regenerate/review it after any reported drift.
VIRTIO_MEM_COMPATIBILITY_ATTESTATION_PATH=/etc/virtio-mem-host/win11_gpu.attestation.json
