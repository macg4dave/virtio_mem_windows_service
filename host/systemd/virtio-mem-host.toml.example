# Copy to /etc/virtio-mem-host/<instance>.toml and replace every "REQUIRED_*"
# marker from reviewed deployment evidence. The file is refused while any
# marker remains, and unknown keys are refused. It contains no secrets.

# All operational timing is selected for this deployment. Record the rationale
# and ensure the service manager stop bound is compatible with these values.
poll_interval_seconds = "REQUIRED_POLL_INTERVAL_SECONDS"
command_timeout_seconds = "REQUIRED_COMMAND_TIMEOUT_SECONDS"
convergence_timeout_seconds = "REQUIRED_CONVERGENCE_TIMEOUT_SECONDS"
# Growth is refused while host MemAvailable would fall below this.
host_min_headroom_bytes = "REQUIRED_HOST_HEADROOM_BYTES"
# Windows decides when to add or remove memory; this controller admits each
# request, grants free pool bytes by priority and resizes the device. With
# observe_only every request is evaluated and logged, then refused before any
# device command. Start here; set false only for an authorised trial.
observe_only = true
# virsh_binary = "virsh"   # only when the standard executable is not used

# Device bytes shared by every VM below; required with more than one [[vm]].
# The pool only tracks free bytes and who gets them first: a VM holds
# max(requested, current), and growth comes from what is free, higher priority
# first, possibly as a partial grant. The pool never takes memory back; each
# guest decides when to release memory.
# Sizes take "16GB", "8.5GB", "1024MB" or a plain byte count (binary units).
# pool_bytes = "16GB"

# One table per VM. Larger priority is served first when free bytes run out.
[[vm]]
name = "REQUIRED_VM_NAME"
alias = "REQUIRED_DEVICE_ALIAS"
priority = "REQUIRED_PRIORITY"

# Persistent state paths must be absolute, instance-scoped, and provisioned
# with the documented least-privilege ownership and ACLs.
policy_state_path = "/var/lib/virtio-mem-host/state/REQUIRED_INSTANCE-policy.json"
compatibility_attestation_path = "REQUIRED_ABSOLUTE_ATTESTATION_PATH"

# The Windows publication carrying telemetry and the guest's request. The
# host writes device status and request results to "<telemetry_path>.host-status".
# Single quotes keep Windows backslashes literal.
telemetry_transport = "qga-file"
telemetry_path = 'REQUIRED_ABSOLUTE_WINDOWS_TELEMETRY_PATH'
telemetry_service_name = "REQUIRED_WINDOWS_SERVICE_NAME"
telemetry_max_age_seconds = "REQUIRED_TELEMETRY_MAX_AGE_SECONDS"
telemetry_future_tolerance_seconds = "REQUIRED_TELEMETRY_FUTURE_TOLERANCE_SECONDS"
