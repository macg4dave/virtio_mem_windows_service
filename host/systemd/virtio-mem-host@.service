[Unit]
Description=Virtio-mem controller for %i
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=exec
User=virtio-mem-host
Group=virtio-mem-host
EnvironmentFile=/etc/virtio-mem-host/%i.conf
Environment=LIBVIRT_DEFAULT_URI=qemu:///system
Environment=HOME=/run/virtio-mem-host
Environment=XDG_CACHE_HOME=/run/virtio-mem-host/.cache
ExecStart=/usr/local/libexec/virtio-mem-host
# Failure is fail-stop. Deployment monitoring decides when a reviewed restart
# is appropriate; the unit does not create an automatic restart loop.
Restart=no
# Inherit the host manager's configured stop timeout rather than embedding a
# test-derived deadline in the repository unit.
RuntimeDirectory=virtio-mem-host
RuntimeDirectoryMode=0700
StateDirectory=virtio-mem-host/state
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
