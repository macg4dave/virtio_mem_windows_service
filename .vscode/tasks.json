{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RHEL: local gate",
      "type": "shell",
      "command": "cargo",
      "args": ["xtask", "gate", "local"],
      "problemMatcher": []
    },
    {
      "label": "Windows: native gate",
      "type": "shell",
      "command": "cargo",
      "args": ["xtask", "windows", "all"],
      "options": {
        "env": {
          "VIRTIO_MEM_WINDOWS_SSH": "${input:windowsSshTarget}",
          "VIRTIO_MEM_WINDOWS_DIR": "${input:windowsWorkspace}",
          "VIRTIO_MEM_WINDOWS_ARTIFACTS": "${input:windowsArtifacts}",
          "VIRTIO_MEM_WINDOWS_CONNECT_TIMEOUT_SECONDS": "${input:windowsConnectTimeout}",
          "VIRTIO_MEM_WINDOWS_OPERATION_TIMEOUT_SECONDS": "${input:windowsOperationTimeout}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Build: all non-mutating gates",
      "dependsOrder": "sequence",
      "dependsOn": ["RHEL: local gate", "Windows: native gate"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "windowsSshTarget",
      "type": "promptString",
      "description": "Configured SSH target for the Windows build guest"
    },
    {
      "id": "windowsWorkspace",
      "type": "promptString",
      "description": "Absolute Windows workspace path"
    },
    {
      "id": "windowsArtifacts",
      "type": "promptString",
      "description": "Local directory for verified Windows artifacts"
    },
    {
      "id": "windowsConnectTimeout",
      "type": "promptString",
      "description": "SSH connection timeout in seconds"
    },
    {
      "id": "windowsOperationTimeout",
      "type": "promptString",
      "description": "Per-operation timeout in seconds"
    }
  ]
}
